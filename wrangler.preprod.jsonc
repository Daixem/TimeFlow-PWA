{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "timeflow-preprod",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-09-23",
  "workers_dev": true,
  "vars": {
    "TIMEFLOW_WORK_TIME_SERVER_ENABLED": "true",
    "TIMEFLOW_WORK_TIME_POLICY_VERSION": "preprod-v1",
    "TIMEFLOW_WORK_TIME_AUTO_BREAK_ENABLED": "true",
    "TIMEFLOW_WORK_TIME_AUTO_BREAK_AFTER_MINUTES": "360",
    "TIMEFLOW_WORK_TIME_AUTO_BREAK_MINUTES": "30",
    "TIMEFLOW_BETA_ADMIN_USER_FINGERPRINT": "0aa4cd6473df862613041acfea706cf88d3f9dc1a5c59f49dc2ce1a9de0248c5",
    "TIMEFLOW_CLOUDFLARE_ACCESS_ENABLED": "true"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "timeflow-migration-test-20260917",
      "database_id": "4826b07d-8a23-4098-80d7-ee6a6469bcab",
      "migrations_dir": "drizzle"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
